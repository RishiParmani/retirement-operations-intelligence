	partition operations_clean = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolderPath, "\") & "\operations_clean.csv"), [Delimiter=",", Columns=33, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {
							{"operation_id", type text},
							{"customer_id", type text},
							{"account_id", type text},
							{"plan_id", type text},
							{"operation_type", type text},
							{"priority", type text},
							{"channel", type text},
							{"region", type text},
							{"processing_team", type text},
							{"team_workload", Int64.Type},
							{"customer_segment", type text},
							{"received_at", type datetime},
							{"assigned_at", type datetime},
							{"started_at", type datetime},
							{"completed_at", type datetime},
							{"status", type text},
							{"exception_flag", type logical},
							{"exception_type", type text},
							{"exception_severity", type text},
							{"root_cause", type text},
							{"rework_flag", type logical},
							{"sla_target_hours", Int64.Type},
							{"processing_hours", type number},
							{"sla_breached", Int64.Type},
							{"transaction_amount", type number},
							{"currency", type text},
							{"missing_info_flag", type logical},
							{"received_date", type date},
							{"received_year", Int64.Type},
							{"received_month", Int64.Type},
							{"received_week", Int64.Type},
							{"received_day_of_week", type text},
							{"data_quality_score", Int64.Type}
						}, "en-US"),
				AddCompletedDate = Table.AddColumn(Typed, "completed_date", each if [completed_at] = null then null else DateTime.Date([completed_at]), type nullable date),
				AddPriorityRank = Table.AddColumn(AddCompletedDate, "priority_rank", each if [priority] = "Critical" then 1 else if [priority] = "High" then 2 else if [priority] = "Medium" then 3 else 4, Int64.Type),
				Trimmed = Table.RemoveColumns(AddPriorityRank, {"customer_id", "account_id", "plan_id", "completed_at", "received_year", "received_month", "received_week", "received_day_of_week"}),
				Reordered = Table.ReorderColumns(Trimmed, {"operation_id", "operation_type", "priority", "channel", "region", "processing_team", "team_workload", "customer_segment", "received_at", "assigned_at", "started_at", "status", "exception_flag", "exception_type", "exception_severity", "root_cause", "rework_flag", "sla_target_hours", "processing_hours", "sla_breached", "transaction_amount", "currency", "missing_info_flag", "received_date", "data_quality_score", "completed_date", "priority_rank"})
			in
				Reordered
