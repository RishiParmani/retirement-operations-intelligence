table operations_clean
	lineageTag: 2af83178-6277-5914-b67a-a7cbca7a537e

	measure 'Total Operations' = COUNTROWS(operations_clean)
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 26e3fdd7-5372-5b33-a261-3903b6ce6d1b

	measure 'Completed Operations' = CALCULATE([Total Operations], operations_clean[status] = "Completed")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: a7e43be7-5322-5c49-9525-845049ec729d

	measure 'Pending Operations' = CALCULATE([Total Operations], operations_clean[status] = "Pending")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: f68cc15c-813c-56e0-ae41-cb798d3d7a37

	measure 'Failed Operations' = CALCULATE([Total Operations], operations_clean[status] = "Failed")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: d31596ac-1971-5d0d-8aa9-6fc0453d627d

	measure 'Escalated Operations' = CALCULATE([Total Operations], operations_clean[status] = "Escalated")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 2ab97148-6c06-58de-b859-7ab58aa41858

	measure 'Completion Rate %' = DIVIDE([Completed Operations], [Total Operations])
		formatString: 0.0%
		displayFolder: 1 Volume
		lineageTag: 15897a65-aed0-55d0-983c-6a1d99f4912d

	measure 'Operations Completed (by Completion Date)' = CALCULATE([Completed Operations], USERELATIONSHIP(operations_clean[completed_date], Calendar[Date]))
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: bc48eb0a-37e7-517c-bf94-6291c6688569

	measure 'Average Processing Hours' = CALCULATE(AVERAGE(operations_clean[processing_hours]), operations_clean[status] = "Completed")
		formatString: #,0.0
		displayFolder: 2 Processing
		lineageTag: 042c4aa7-e35d-5a82-857a-6aae1b4d5462

	measure 'Average SLA Target Hours' = CALCULATE(AVERAGE(operations_clean[sla_target_hours]), operations_clean[status] = "Completed")
		formatString: #,0.0
		displayFolder: 2 Processing
		lineageTag: 07f0c7d4-ecec-50d2-869d-6c62122452bf

	measure 'SLA Breach Count' = CALCULATE(SUM(operations_clean[sla_breached]), operations_clean[status] = "Completed")
		formatString: #,0
		displayFolder: 3 SLA
		lineageTag: 5fb1419b-bd1f-55d6-b0d4-e2c4f894b2d8

	measure 'SLA Breach Rate' = DIVIDE([SLA Breach Count], [Completed Operations])
		formatString: 0.0%
		displayFolder: 3 SLA
		lineageTag: d74ed57a-5ec0-5f2f-9eb8-7ebf9735b8ef

	measure 'SLA Compliance %' = DIVIDE([Completed Operations] - [SLA Breach Count], [Completed Operations])
		formatString: 0.0%
		displayFolder: 3 SLA
		lineageTag: fd875e8d-ce84-5bdd-a05e-57aae46336e1

	measure 'Exception Count' = CALCULATE([Total Operations], operations_clean[exception_flag] = TRUE())
		formatString: #,0
		displayFolder: 4 Exceptions & Rework
		lineageTag: 068afeb2-bb50-5679-8be0-c4ee597c8027

	measure 'Exception Rate %' = DIVIDE([Exception Count], [Total Operations])
		formatString: 0.0%
		displayFolder: 4 Exceptions & Rework
		lineageTag: 7e3bc8ee-2d44-55c6-83b1-d9d66afe64ee

	measure 'Rework Count' = CALCULATE([Total Operations], operations_clean[rework_flag] = TRUE())
		formatString: #,0
		displayFolder: 4 Exceptions & Rework
		lineageTag: 37403209-2fe6-5d5a-85a1-f4e1400950a3

	measure 'Rework Rate %' = DIVIDE([Rework Count], [Total Operations])
		formatString: 0.0%
		displayFolder: 4 Exceptions & Rework
		lineageTag: 52131eed-421c-5ea3-8dd3-74dd1a1ea8a6

	measure 'Total Transaction Amount' = SUM(operations_clean[transaction_amount])
		formatString: $#,0.0,,
		displayFolder: 5 Financial
		lineageTag: f4c24b0c-85d3-52e9-9f35-c1f418858443

	measure 'Insight - Top Volume Operation Type' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [Total Operations])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: fca2f70f-a9b0-5ad0-aac5-7cdf999568e9

	measure 'Insight - Most SLA Breaches (Operation Type)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [SLA Breach Count])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: c090c5ec-a851-5581-a2d4-7eab9dffed65

	measure 'Insight - Highest SLA Breach Rate (Priority)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[priority]), "@v", [SLA Breach Rate])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[priority]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: 808c19d3-ab4a-5fcb-a853-61f8ee189124

	measure 'Insight - Region With Most Exceptions' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[region]), "@v", [Exception Count])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[region]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: d9250a9f-5c55-5913-b909-8b640a2b83ce

	measure 'Insight - Highest Exception Rate (Channel)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[channel]), "@v", [Exception Rate %])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[channel]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: da14682b-ef3a-5429-8da7-a2f409798287

	measure 'Insight - Highest Rework Rate (Operation Type)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [Rework Rate %])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: cdcb42ff-94dd-5d2b-ac8a-06d7983228ac

	measure 'Insight - Peak Month By Volume' =
			VAR _t = ADDCOLUMNS(VALUES(Calendar[Month Year]), "@v", [Total Operations])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, Calendar[Month Year]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: 5aa2232f-503a-5136-84c5-daf1096edb2b

