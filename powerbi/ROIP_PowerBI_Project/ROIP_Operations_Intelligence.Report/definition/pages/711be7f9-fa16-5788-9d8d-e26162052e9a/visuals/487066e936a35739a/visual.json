                      "fontSize": "9pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "These are associations in synthetic data. They show where to look first, not proven causes.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1E293B",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Backlog age is measured against the latest received date in the data, not today.",
