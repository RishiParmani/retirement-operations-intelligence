	partition dq_rule_results = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DQFolderPath & "\dq_rule_results.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"rule_id", type text}, {"rule_name", type text}, {"stage", type text}, {"severity", type text}, {"rows_affected", Int64.Type}, {"pct_of_raw", type number}, {"action", type text}, {"description", type text}}, "en-US")
