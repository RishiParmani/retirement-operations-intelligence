table operations_clean
	lineageTag: 2af83178-6277-5914-b67a-a7cbca7a537e

	/// Count of operations.
	measure 'Total Operations' = COUNTROWS(operations_clean)
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 26e3fdd7-5372-5b33-a261-3903b6ce6d1b

	measure 'Completed Operations' = CALCULATE([Total Operations], operations_clean[status] = "Completed")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: a7e43be7-5322-5c49-9525-845049ec729d

	measure 'Pending Operations' = CALCULATE([Total Operations], operations_clean[status] = "Pending")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: f68cc15c-813c-56e0-ae41-cb798d3d7a37

	measure 'Failed Operations' = CALCULATE([Total Operations], operations_clean[status] = "Failed")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: d31596ac-1971-5d0d-8aa9-6fc0453d627d

	measure 'Escalated Operations' = CALCULATE([Total Operations], operations_clean[status] = "Escalated")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 2ab97148-6c06-58de-b859-7ab58aa41858

	measure 'Completion Rate %' = DIVIDE([Completed Operations], [Total Operations])
		formatString: 0.0%
		displayFolder: 1 Volume
		lineageTag: 15897a65-aed0-55d0-983c-6a1d99f4912d

	measure 'Operations Completed (by Completion Date)' = CALCULATE([Completed Operations], USERELATIONSHIP(operations_clean[completed_date], Calendar[Date]))
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: bc48eb0a-37e7-517c-bf94-6291c6688569

	/// Helper: total processing hours of completed operations.
	measure 'Completed Processing Hours' = CALCULATE(SUM(operations_clean[processing_hours]), operations_clean[status] = "Completed")
		formatString: #,0.00
		displayFolder: 2 Processing
		lineageTag: dd0c20e4-4ae4-5957-b324-7561e4b9dd38

	/// Helper: total SLA target hours of completed operations.
	measure 'Completed SLA Target Hours' = CALCULATE(SUM(operations_clean[sla_target_hours]), operations_clean[status] = "Completed")
		formatString: #,0
		displayFolder: 2 Processing
		lineageTag: e5c9d52c-0ba7-5569-87cd-cdc7b052b099

	/// Mean processing hours, Completed operations only.
	measure 'Average Processing Hours' = ROUND(DIVIDE([Completed Processing Hours], [Completed Operations]), 2)
		formatString: 0.0
		displayFolder: 2 Processing
		lineageTag: 042c4aa7-e35d-5a82-857a-6aae1b4d5462

	/// Mean SLA target hours, Completed operations only.
	measure 'Average SLA Target Hours' = ROUND(DIVIDE([Completed SLA Target Hours], [Completed Operations]), 2)
		formatString: 0.0
		displayFolder: 2 Processing
		lineageTag: 07f0c7d4-ecec-50d2-869d-6c62122452bf

	/// Pending + Escalated.
	measure 'Open Backlog' = [Pending Operations] + [Escalated Operations]
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: d1dad26c-28e3-50c3-9aab-0b6a0c09db94

	/// Pending for more than 90 days as of the latest received date.
	measure 'Stale Pending (over 90 days)' = CALCULATE([Total Operations], operations_clean[status] = "Pending", operations_clean[age_days] > 90)
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 6914b49d-b00d-5334-9725-05795765d85b

	measure 'SLA Breach Count' = CALCULATE(SUM(operations_clean[sla_breached]), operations_clean[status] = "Completed")
		formatString: #,0
		displayFolder: 3 SLA
		lineageTag: 5fb1419b-bd1f-55d6-b0d4-e2c4f894b2d8

	measure 'SLA Breach Rate' = DIVIDE([SLA Breach Count], [Completed Operations])
		formatString: 0.0%
		displayFolder: 3 SLA
		lineageTag: d74ed57a-5ec0-5f2f-9eb8-7ebf9735b8ef

	measure 'SLA Compliance %' = DIVIDE([Completed Operations] - [SLA Breach Count], [Completed Operations])
		formatString: 0.0%
		displayFolder: 3 SLA
		lineageTag: fd875e8d-ce84-5bdd-a05e-57aae46336e1

	measure 'Exception Count' = CALCULATE([Total Operations], operations_clean[exception_flag] = TRUE())
		formatString: #,0
		displayFolder: 4 Exceptions & Rework
		lineageTag: 068afeb2-bb50-5679-8be0-c4ee597c8027

	measure 'Exception Rate %' = DIVIDE([Exception Count], [Total Operations])
		formatString: 0.0%
		displayFolder: 4 Exceptions & Rework
		lineageTag: 7e3bc8ee-2d44-55c6-83b1-d9d66afe64ee

	measure 'Rework Count' = CALCULATE([Total Operations], operations_clean[rework_flag] = TRUE())
		formatString: #,0
		displayFolder: 4 Exceptions & Rework
		lineageTag: 37403209-2fe6-5d5a-85a1-f4e1400950a3

	measure 'Rework Rate %' = DIVIDE([Rework Count], [Total Operations])
		formatString: 0.0%
		displayFolder: 4 Exceptions & Rework
		lineageTag: 52131eed-421c-5ea3-8dd3-74dd1a1ea8a6

	/// This slice's share of all breaches in the current filter context.
	measure 'Share of SLA Breaches' = DIVIDE([SLA Breach Count], CALCULATE([SLA Breach Count], ALLSELECTED(operations_clean)))
		formatString: 0.0%
		displayFolder: 3 SLA
		lineageTag: 1ef098ca-6a0a-52f3-9e46-7bc6f2eadedb

	/// Same as Open Backlog; used on the age chart.
	measure 'Open Backlog Operations (by age)' = CALCULATE([Total Operations], operations_clean[status] IN {"Pending","Escalated"})
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: b6143b31-76e7-5cd1-9bd9-bfdf445dd553

	measure 'Total Transaction Amount' = SUM(operations_clean[transaction_amount])
		formatString: $#,0.0,,
		displayFolder: 5 Financial
		lineageTag: f4c24b0c-85d3-52e9-9f35-c1f418858443

	measure 'Insight - Top Volume Operation Type' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [Total Operations])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: fca2f70f-a9b0-5ad0-aac5-7cdf999568e9

	measure 'Insight - Most SLA Breaches (Operation Type)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [SLA Breach Count])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: c090c5ec-a851-5581-a2d4-7eab9dffed65

	measure 'Insight - Highest SLA Breach Rate (Priority)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[priority]), "@v", [SLA Breach Rate])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[priority]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: 808c19d3-ab4a-5fcb-a853-61f8ee189124

	measure 'Insight - Region With Most Exceptions' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[region]), "@v", [Exception Count])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[region]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: d9250a9f-5c55-5913-b909-8b640a2b83ce

	measure 'Insight - Highest Exception Rate (Channel)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[channel]), "@v", [Exception Rate %])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[channel]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: da14682b-ef3a-5429-8da7-a2f409798287

	measure 'Insight - Highest Rework Rate (Operation Type)' =
			VAR _t = ADDCOLUMNS(VALUES(operations_clean[operation_type]), "@v", [Rework Rate %])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, operations_clean[operation_type]) & " (" & FORMAT(_val, "0.0%") & ")")
		displayFolder: 6 Insights
		lineageTag: cdcb42ff-94dd-5d2b-ac8a-06d7983228ac

	measure 'Insight - Peak Month By Volume' =
			VAR _t = ADDCOLUMNS(VALUES(Calendar[Month Year]), "@v", [Total Operations])
			VAR _top = TOPN(1, _t, [@v], DESC)
			VAR _val = MAXX(_top, [@v])
			RETURN IF(ISBLANK(_val), "n/a", MAXX(_top, Calendar[Month Year]) & " (" & FORMAT(_val, "#,0") & ")")
		displayFolder: 6 Insights
		lineageTag: 5aa2232f-503a-5136-84c5-daf1096edb2b

	/// Records in the raw extract.
	measure 'DQ Raw Records' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "raw_records")
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: aef04691-765f-5adf-b277-2a19cfa6bd98

	/// Records loaded after validation.
	measure 'DQ Clean Records' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "clean_records")
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: 69df4e5d-1683-5354-b521-c367be7534e5

	/// Records refused by reject rules (see dq_rejected_records.csv).
	measure 'DQ Rejected Records' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "rejected_records")
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: df6fc4c7-1c71-52e1-aca5-726d2c261dd8

	/// Clean / raw, in percent.
	measure 'DQ Acceptance Rate %' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "acceptance_rate_pct")
		formatString: 0.0
		displayFolder: 7 Data Quality
		lineageTag: f4363770-9521-5179-b6a0-938038b81f5c

	/// Share of raw records with a unique operation_id.
	measure 'DQ Uniqueness %' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "uniqueness_pct")
		formatString: 0.0
		displayFolder: 7 Data Quality
		lineageTag: 3a371081-ede2-5ee6-bf47-c7cff655a9bc

	/// Share of raw records passing category / range rules.
	measure 'DQ Validity %' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "validity_pct")
		formatString: 0.0
		displayFolder: 7 Data Quality
		lineageTag: 3d23c15e-ff1d-5162-967f-0d8c0ee7ae3c

	/// Missing region labelled Unknown (not dropped).
	measure 'DQ Region Imputed' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "region_imputed_unknown")
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: 6760368b-a93b-5872-8d9a-207a5dc28223

	/// Flag-stage rule hits (records retained).
	measure 'DQ Warning Flags' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "warning_flag_events")
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: c370f65e-d3ad-55ce-807a-d740a8bdfa87

	/// Mean per-record data_quality_score.
	measure 'DQ Mean Quality Score' = CALCULATE(SUM(dq_run_summary[value]), dq_run_summary[metric] = "mean_data_quality_score")
		formatString: 0.0
		displayFolder: 7 Data Quality
		lineageTag: c33e52bb-2d64-513f-9d6c-e7916af3b19c

	measure 'Rule Rows Affected' = SUM(dq_rule_results[rows_affected])
		formatString: #,0
		displayFolder: 7 Data Quality
		lineageTag: ffff88c2-0f3f-5be0-b27c-ecdf33f61b33

	measure 'Rule Pct of Raw' = SUM(dq_rule_results[pct_of_raw])
		formatString: 0.00
		displayFolder: 7 Data Quality
		lineageTag: e3743b9c-7755-5590-bff0-2270b90b0352

	/// Diagnostic: should equal Total Operations.
	measure 'Diag - Row Count' = COUNTROWS(operations_clean)
		formatString: #,0
		displayFolder: 8 Diagnostics
		lineageTag: c284e983-7965-5ef7-89cf-2b90fcbe5eb2

	/// Diagnostic: completed rows where processing_hours loaded as a number. If lower than Completed Operations, the CSV column is not typed numeric.
	measure 'Diag - Completed Rows With Hours' = CALCULATE(COUNTROWS(operations_clean), operations_clean[status] = "Completed", NOT ISBLANK(operations_clean[processing_hours]))
		formatString: #,0
		displayFolder: 8 Diagnostics
		lineageTag: 0aa0e2b0-965c-5c28-9133-de2b49595330

	/// Diagnostic: if blank, processing_hours did not load as numbers.
	measure 'Diag - Sum Processing Hours' = SUM(operations_clean[processing_hours])
		formatString: #,0
		displayFolder: 8 Diagnostics
		lineageTag: 47a15a49-3ee2-5af3-bdd6-4962d7511cde

	measure 'Diag - Min Sla Target' = MIN(operations_clean[sla_target_hours])
		formatString: 0
		displayFolder: 8 Diagnostics
		lineageTag: ebeb0631-c176-5eff-83fd-e4ffbd0cc711

