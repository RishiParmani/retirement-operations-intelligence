# Optional overrides, read from real environment variables (export them in your shell; there is no .env loader). Never put secrets in the repo.
# ROIP_DATA_DIR=./data
# ROIP_REPORTS_DIR=./reports
# ROIP_SEED=42
# ROIP_ROWS=200000
# Only needed if you load the data into your own PostgreSQL (see sql/README.md):
# DATABASE_URL=postgresql://user:password@localhost:5432/roip
